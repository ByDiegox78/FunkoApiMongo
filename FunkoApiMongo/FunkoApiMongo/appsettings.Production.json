{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Error"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/funko-.log",
                    "rollingInterval": "Day"
                }
            }
        ],
        "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
    },
    "ApiSettings": {
        "Name": "Production"
    },
    "Funkos": {
        "RepositoryType": "MongoEF"
    },
    "ConnectionStrings": {
        "MongoDb": "mongodb://mongo_db:27017",
        "Redis": "redis:6379"
    },
    "DatabaseSettings": {
        "Name": "funkos_prod"
    },
    "Cache": {
        "Name": "Redis",
        "ExpiryMinutes": 30,
        "SlidingExpirationMinutes": 10
    }
}