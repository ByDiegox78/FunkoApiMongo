{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/funko-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "ApiSettings": {
    "Name": "Develop"
  },
  "Funkos": {
    "RepositoryType": "MongoNative"
  },
  "ConnectionStrings": {
    "MongoDb": "mongodb://localhost:27017"
  },
  "DatabaseSettings": {
    "Name": "funkos_dev"
  },
  "Cache": {
    "Name": "MemCache",
    "ExpiryMinutes": 30,
    "SlidingExpirationMinutes": 10
  }
}